# latexmk settings for rpn-typesetter. Copy this file into your project as
# `.latexmkrc` (latexmk reads it automatically), then run `latexmk paper.rtex`,
# or `latexmk -pvc paper.rtex` to rebuild whenever paper.rtex changes.
#
# Every pdfLaTeX pass first runs rpn-typesetter, which turns paper.rtex into
# paper.tex; pdfLaTeX then compiles paper.tex. If any RPN is invalid,
# rpn-typesetter exits with an error, so pdfLaTeX never runs.

$pdf_mode = 1;
$pdflatex = 'rpn-typesetter %S && pdflatex %O %R.tex';
