# latexmk settings for rpn-typesetter.
#
# Per project: copy this file next to paper.rtex as `.latexmkrc` and run
# `latexmk paper.rtex` (or `latexmk -pvc paper.rtex` to rebuild on every save).
#
# For every project at once: put the $pdflatex line in ~/.latexmkrc instead.
# `--latexmk` makes rpn-typesetter convert .rtex files and leave ordinary .tex
# files alone, so your other documents build exactly as before.
#
# Every pdfLaTeX pass first turns paper.rtex into paper.tex, then compiles
# paper.tex. If any RPN is invalid, rpn-typesetter exits with an error, so
# pdfLaTeX never runs.

$pdf_mode = 1;
$pdflatex = 'rpn-typesetter --latexmk %S && pdflatex %O %R.tex';
