{
  "name": "rpn-typesetter",
  "version": "0.2.0",
  "private": true,
  "description": "LaTeX preprocessor: RPN math in, plain LaTeX out",
  "license": "LPPL-1.3c",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedoge/rpn-typesetter.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rpn-typesetter": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples/latexmkrc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "ctan": "sh scripts/ctan.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
